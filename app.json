{
  "expo": {
    "name": "EcoTrail",
    "slug": "ecotrail",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ecotrail",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fbf8f2",
    "ios": {
      "bundleIdentifier": "az.ecotrail.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "az.ecotrail.app",
      "adaptiveIcon": {
        "backgroundColor": "#1d3f2a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1d3f2a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EcoTrail uses your location to show trails near you and to mark a trailhead when you share a trail."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EcoTrail needs access to your photos so you can add pictures to a trail you share.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b4bd04f-87ef-4482-a8d2-c93034d3a705"
      }
    },
    "owner": "arto_rashid",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3b4bd04f-87ef-4482-a8d2-c93034d3a705"
    }
  }
}
